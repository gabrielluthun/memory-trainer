# Copy to .env (ignored by git) and fill in. Never commit real values (ES09).
# Only PUBLIC_ variables reach the browser: they are public by design (ES08).

# Neon PostgreSQL connection string of the dev branch: direct connection (no -pooler),
# used by dbmate on this machine only.
# Never a production URL (no production credentials on this machine).
DATABASE_URL=

# Hanko project API URL (public)
PUBLIC_HANKO_API_URL=

# Neon Data API endpoint of the dev branch
PUBLIC_DATA_API_URL=
