{
	"name": "memory-trainer",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "npm run i18n; svelte-kit sync || echo ''; git config core.hooksPath .githooks 2>/dev/null || true",
		"i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy custom-settings baseLocale",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"secrets": "gitleaks git --redact --verbose",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"db:new": "dbmate new",
		"db:up": "dbmate --migrations-table dbmate.schema_migrations --no-dump-schema --migration-lock up",
		"db:down": "dbmate --migrations-table dbmate.schema_migrations --no-dump-schema down",
		"db:status": "dbmate --migrations-table dbmate.schema_migrations status"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.17",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^3.2.2",
		"@inlang/plugin-message-format": "^4.6.1",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26",
		"@vite-pwa/sveltekit": "^2.0.4",
		"@vitest/coverage-v8": "^5.1.1",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"fake-indexeddb": "^6.2.8",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.1",
		"wrangler": "^4.166.0"
	},
	"dependencies": {
		"@neondatabase/postgrest-js": "^0.2.0-beta",
		"@teamhanko/hanko-elements": "^3.2.0",
		"dexie": "^4.4.7"
	}
}
